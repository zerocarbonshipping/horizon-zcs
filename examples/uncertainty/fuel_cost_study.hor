# Example Horizon study: fuel cost uncertainty.
#
# This example samples three uncertain parameters across two policy scenarios.
# `horizon check` and `horizon run --dry-run` work on it without Navigate or a
# queue; template.unc is a sketch, not a runnable Navigate deck.
#
# To turn it into a real study: point UncFilePath at your own Navigate deck with
# %NAME% placeholders and run `horizon run fuel_cost_study.hor`, here or through
# a queue (`--command pueue`).

# Every block below takes part in the study. The block name is the placeholder
# in the deck (%POLICY%, %FUEL_PRICE%, ...). Set active = FALSE to fix a
# parameter at its default.

ScenarioParameter "POLICY" {
    default = "baseline"
    values = ["baseline", "carbon_levy"]
}

ContinuousParameter "FUEL_PRICE" {
    default = 1.0
    low_val = 0.8
    high_val = 1.5
    distribution = UNIFORM

    # under a carbon levy, fuel prices shift upward
    if POLICY = carbon_levy {
        low_val = 1.0
        high_val = 2.0
    }
}

# No default: sample_1 uses mid_val
ContinuousParameter "DEMAND_GROWTH" {
    low_val = 0.01
    mid_val = 0.025
    high_val = 0.04
    distribution = TRIANGULAR
}

DiscreteParameter "RENEWAL" {
    default = 0.05
    values = [0.03, 0.05, 0.08]
    probabilities = [0.25, 0.5, 0.25]
}

Horizon {
    UncFilePath = "template.unc"
    OutputPath = "output"
    NumberOfSamples = 25
    SamplingMethod = LHS
    RandomSeed = 42
}
