# Example Horizon configuration: fuel cost uncertainty study.
#
# This example samples three uncertain parameters across two policy scenarios
# and stops after sampling (SampleOnly = TRUE), so it runs without Navigate or
# pueue installed. It writes the sampled values and diagnostic plots to the
# output folder.
#
# To turn it into a real study: point UncFilePath at a tokenized copy of your
# own Navigate simulation file, set SampleOnly = FALSE, and make sure the
# pueue daemon is running.

# Every block below takes part in the study. The block name is the token used
# in the template (%POLICY%, %FUEL_PRICE%, ...). Set active = FALSE to fix a
# parameter at its default.

ScenarioParameter "POLICY" {
    name = "Policy scenario"
    default = "baseline"
    values = ["baseline", "carbon_levy"]
}

ContinuousParameter "FUEL_PRICE" {
    name = "Fuel price multiplier"
    default = 1.0
    low_val = 0.8
    high_val = 1.5
    decimals = 2
    distribution = "uniform"

    # under a carbon levy, fuel prices shift upward
    if POLICY = carbon_levy {
        low_val = 1.0
        high_val = 2.0
    }
}

# No default: sample_1 uses mid_val
ContinuousParameter "DEMAND_GROWTH" {
    name = "Demand growth rate"
    low_val = 0.01
    mid_val = 0.025
    high_val = 0.04
    decimals = 3
    distribution = "triangular"
}

DiscreteParameter "RENEWAL" {
    name = "Fleet renewal rate"
    default = 0.05
    values = [0.03, 0.05, 0.08]
    probabilities = [0.25, 0.5, 0.25]
}

Horizon {
    UncFilePath = "template.unc"
    OutputPath = "output/samples.csv"
    NumberOfSamples = 25
    SamplingMethod = LHS
    RandomSeed = 42
    SampleOnly = TRUE
}
