Horizon {
	# Path to .unc file
	UncFilePath = "./run.unc"

	# Path to store output
	OutputPath = "./samples/samples.csv"

	# settings
	NumberOfSamples = 300 	# remember this multiplies with ScenarioParameter combinations
	RandomSeed = 69			# Set random seed for reproducable random results
	# SampleOnly = TRUE		# if true, horizon terminates before file creation
}

# Format notes (requires horizon with the short .hor format):
# - Every parameter block below is part of the run. To leave one out, comment out the whole block.
#   active = FALSE keeps it in the run, fixed at its default.
# - The block name is the token (%name% in the .unc) and the display name.
# - default = mid_val unless set explicitly. Inside an "if" block, a new mid_val also moves the default.
# - distribution defaults to LOG-TRIANGULAR; other options: TRIANGULAR, LOG-UNIFORM, UNIFORM.
# - decimals are set automatically from the range (step <= 1/10,000 of the range).
# - Scenarios without a matching "if" block use the base values.
# - emissions_low defaults to MINIMUM; only MAXIMUM is written out.
# - Check after every edit: horizon run.hor --check (typos, ranges, tokens, policy files);
#   horizon run.hor --explain prints the resolved values per policy.

# ------------------------- Scenario parameters ------------------------- #
ScenarioParameter "policy" {
	values = ["nzf_as_is_disallow", "nzf_bracketed_disallow", "nzf_tuvalu",
	          "liberia", "liberia_s2", "bau",
	          "japan_s1_disallow", "japan_s2_disallow",
	          "landing_zone_optimistic", "landing_zone_pessimistic"]
	default = "nzf_as_is_disallow"
}

# ------------------------- Uncertainties impacted by policy axis ------------------------- #

ContinuousParameter "operational_ee" {
	low_val      = 0.10
	mid_val      = 0.15
	high_val     = 0.20
	distribution = TRIANGULAR
	emissions_low = MAXIMUM

	# No or minimal regulatory pressure. Liberia S2: market-defined architecture.
	if policy in (bau, liberia, liberia_s2) {
		low_val  = 0.00
		mid_val  = 0.05
		high_val = 0.10
	}

	if policy = nzf_tuvalu {
		low_val  = 0.15
		mid_val  = 0.20
		high_val = 0.25
	}

	# Real GFS-style compliance pressure: these use the base values above.
	if policy in (nzf_as_is_disallow, nzf_bracketed_disallow, japan_s1_disallow,
	              japan_s2_disallow, landing_zone_optimistic, landing_zone_pessimistic) {
	}
}

# ------------------------- Global alignment parameters ------------------------- #

# Vessel WACC multiplier on base WACC (8.89%).
# Low alignment = higher financing costs (risk premium); high alignment = favorable green finance.
# Log-triangular: symmetric treatment of halving vs doubling the base WACC.
ContinuousParameter "vessel_wacc_multiplier" {
	low_val      = 0.6
	mid_val      = 1.0
	high_val     = 1.8
}

# ------------------------- Sampled parameters for biomass availability ------------------------- #

# Biogas feedstock share allocated to shipping.
# Log-triangular with mode from biofuel assumptions research (25% base case).
ContinuousParameter "feedstock_biogas_share_shipping" {
	low_val      = 0.10
	mid_val      = 0.25
	high_val     = 0.65
	emissions_low = MAXIMUM
}

# Bioethanol fermentation feedstock share allocated to shipping.
# Research base case: 1-4% (mode ~2-3%).
ContinuousParameter "feedstock_bioethanol_fermentation_share_shipping" {
	low_val      = 0.001
	mid_val      = 0.03
	high_val     = 0.12
	default      = 0.02
	emissions_low = MAXIMUM
}

# Biomethanol gasification feedstock share allocated to shipping.
# Research base case: 5-10% (mode ~7%). Log-triangular with mode at 0.08.
ContinuousParameter "feedstock_biomethanol_gasification_share_shipping" {
	low_val      = 0.02
	mid_val      = 0.08
	high_val     = 0.20
	default      = 0.07
	emissions_low = MAXIMUM
}

# Used cooking oil share allocated to shipping.
# Research base case: 2-5% (mode ~3%).
ContinuousParameter "used_cooking_oil_shipping_share" {
	low_val      = 0.001
	mid_val      = 0.03
	high_val     = 0.12
	emissions_low = MAXIMUM
}

# Biogenic CO2 share allocated to shipping.
ContinuousParameter "carbon_dioxide_biogenic_shipping_share" {
	low_val      = 0.001
	mid_val      = 0.10
	high_val     = 0.20
	emissions_low = MAXIMUM
}

# ------------------------- Sampled parameters for infrastructure economy development  ---------- #

# Plant capacity multiplier on base design capacity.
# Log-triangular range spans full low→high across all former MTC scenarios.
ContinuousParameter "plant_capacity_multiplier" {
	low_val       = 0.4
	mid_val       = 1.0
	high_val      = 2.5
	emissions_low = MAXIMUM
}

# Plant lead time in years. Electro plants get +1 year offset on top of this.
DiscreteParameter "plant_lead_time" {
	values        = [3, 4, 5, 6]
	probabilities = [0.15, 0.35, 0.35, 0.15]
	default       = 4
}

# Electro & blue plant WACC multiplier on base WACC (~10% declining to ~6%).
# Log-triangular: right-skewed — financing for unproven tech more likely worse than expected.
ContinuousParameter "h2_wacc_multiplier" {
	low_val      = 0.5
	mid_val      = 1.0
	high_val     = 1.8
}


# ------------------------- Biomass cost parameters (scenario-independent) -------------------- #
# Costs and availability are sampled independently. Cost uncertainty exists regardless of
# availability level. All use log-triangular — right-skewed cost distributions are empirically
# well-established for commodity and process costs.

# Biogas feedstock cost (USD/dry ton): blended pool of waste streams (~$50/dry ton base case).
# 4x range (25-100) appropriate for heterogeneous waste stream.
ContinuousParameter "feedstock_biogas_cost" {
	low_val      = 25
	mid_val      = 50
	high_val     = 100
}

# Fermentation feedstock cost (USD/dry tonne): crop residues (corn stover, wheat straw).
ContinuousParameter "feedstock_bioethanol_fermentation_cost" {
	low_val      = 38
	mid_val      = 60
	high_val     = 140
}

# Gasification feedstock cost (USD/dry tonne): woody residues from forestry/pulp operations.
ContinuousParameter "feedstock_biomethanol_gasification_cost" {
	low_val      = 35
	mid_val      = 65
	high_val     = 120
}

# Used cooking oil cost Europe (USD/ton): volatile waste commodity with documented
# $800-2000/ton swings in 2020-2024.
ContinuousParameter "used_cooking_oil_cost_europe" {
	low_val      = 565
	mid_val      = 1130
	high_val     = 2260
}

# Biogenic CO2 cost (USD/ton).
ContinuousParameter "carbon_dioxide_biogenic_cost" {
	low_val      = 30
	mid_val      = 70
	high_val     = 180
}

# ------------------------- Other parameters -------------------------------------------------- #

# Electricity cost multiplier applied to all regions.
# Log-triangular: cost multiplier — symmetric treatment of cost increases vs decreases.
ContinuousParameter "electricity_cost_interpolator" {
	low_val       = 0.01
	mid_val       = 0.50
	high_val      = 1.00
}

# EPC scaling speed: interpolates between two capacity ramp curves defined in epc_electro_blue.inc.
# interpolator=0.0 → slow ramp (unlimited by 2050).
# interpolator=1.0 → fast ramp (unlimited by 2040).
ContinuousParameter "epc_interpolator" {
	low_val       = 0.0
	high_val      = 1.0
	distribution  = UNIFORM
	default       = 0.5
	emissions_low = MAXIMUM
}